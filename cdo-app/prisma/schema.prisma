generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  password        String?
  image           String?
  currentRole     String?
  targetRole      String    @default("Chief Data Officer")
  targetTimeline  String?
  industry        String?
  skillAssessment Json?
  preferences     Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  goals               Goal[]
  contentInteractions  UserContentInteraction[]
  careerMilestones     CareerMilestone[]
  resumes              Resume[]
  targetCompanies      TargetCompany[]
  trackedPodcasts      TrackedPodcast[]
  accounts             Account[]
  sessions             Session[]
  skillProficiencies   UserSkillProficiency[]
  storyLabProgress     StoryLabProgress[]
  slideSubmissions     SlideSubmission[]
  learningPlans        LearningPlan[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resume {
  id            String   @id @default(cuid())
  userId        String
  fileName      String
  fileUrl       String
  parsedData    Json?
  skillsFound   Json?
  gapAnalysis   Json?
  recommendations Json?
  uploadedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TargetCompany {
  id              String   @id @default(cuid())
  userId          String
  name            String
  industry        String?
  website         String?
  dataTeamSize    String?
  techStack       Json?
  cdoName         String?
  cdoBackground   String?
  notes           String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum GoalType {
  MILESTONE
  HABIT
  TARGET
  PROJECT
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ARCHIVED
}

enum GoalFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  ONCE
}

model Goal {
  id           String        @id @default(cuid())
  userId       String
  type         GoalType
  title        String
  description  String?
  frequency    GoalFrequency @default(ONCE)
  targetValue  Int           @default(1)
  currentValue Int           @default(0)
  deadline     DateTime?
  status       GoalStatus    @default(ACTIVE)
  parentGoalId String?
  skillId      String?
  priority     Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentGoal Goal?      @relation("SubGoals", fields: [parentGoalId], references: [id])
  subGoals   Goal[]     @relation("SubGoals")
  entries    GoalEntry[]
}

model GoalEntry {
  id        String   @id @default(cuid())
  goalId    String
  date      DateTime @default(now())
  value     Int      @default(1)
  notes     String?

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

enum ContentCategory {
  DATA_STRATEGY
  AI_ML
  ANALYTICS
  DATA_ETHICS
  LEADERSHIP
  INDUSTRY_NEWS
  TECHNICAL
}

enum ContentType {
  ARTICLE
  BOOK
  PODCAST
  VIDEO
  COURSE
  REPORT
  INTERVIEW
}

model Content {
  id             String          @id @default(cuid())
  title          String
  url            String          @unique
  source         String
  author         String?
  publishedAt    DateTime?
  summary        String?
  category       ContentCategory
  contentType    ContentType
  relevanceScore Float           @default(0)
  imageUrl       String?
  tags           Json?
  createdAt      DateTime        @default(now())

  interactions UserContentInteraction[]
}

enum InteractionType {
  READ
  SAVED
  DISMISSED
  SHARED
}

model UserContentInteraction {
  id        String          @id @default(cuid())
  userId    String
  contentId String
  action    InteractionType
  timestamp DateTime        @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, action])
}

model TrackedPodcast {
  id             String   @id @default(cuid())
  userId         String
  name           String
  spotifyShowId  String
  gradient       String   @default("from-purple-500 to-blue-500")
  relevance      String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spotifyShowId])
}

model CareerMilestone {
  id            String    @id @default(cuid())
  userId        String
  title         String
  description   String?
  targetDate    DateTime?
  completedDate DateTime?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Invite-Only Auth ─────────────────────────────────────────────────

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  usedBy    String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ── Skill Taxonomy ───────────────────────────────────────────────────

model SkillCluster {
  id          String  @id @default(cuid())
  name        String  @unique
  description String
  order       Int     @default(0)
  skills      Skill[]
}

model Skill {
  id          String  @id @default(cuid())
  clusterId   String
  name        String  @unique
  description String
  anchors     Json?   // { NOT_STARTED, IN_PROGRESS, PROFICIENT, EXPERT }
  order       Int     @default(0)

  cluster      SkillCluster          @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  proficiencies UserSkillProficiency[]
  edgesFrom    SkillEdge[]           @relation("EdgeFrom")
  edgesTo      SkillEdge[]           @relation("EdgeTo")
  jobFrequencies JobSkillFrequency[]
}

enum ProficiencyLevel {
  NOT_STARTED
  IN_PROGRESS
  PROFICIENT
  EXPERT
}

model UserSkillProficiency {
  id        String           @id @default(cuid())
  userId    String
  skillId   String
  level     ProficiencyLevel @default(NOT_STARTED)
  updatedAt DateTime         @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

enum SkillEdgeType {
  ADJACENT
  PREREQUISITE
}

model SkillEdge {
  id         String        @id @default(cuid())
  fromSkillId String
  toSkillId   String
  edgeType    SkillEdgeType

  fromSkill Skill @relation("EdgeFrom", fields: [fromSkillId], references: [id], onDelete: Cascade)
  toSkill   Skill @relation("EdgeTo", fields: [toSkillId], references: [id], onDelete: Cascade)

  @@unique([fromSkillId, toSkillId])
}

// ── Gap Engine: Job Postings ─────────────────────────────────────────

model JobPosting {
  id          String   @id @default(cuid())
  title       String
  company     String
  location    String?
  description String
  url         String?
  source      String   @default("adzuna")
  sourceId    String   @unique
  skills      Json?    // extracted skill IDs
  salary      String?
  fetchedAt   DateTime @default(now())
}

model JobSkillFrequency {
  id           String   @id @default(cuid())
  skillId      String
  frequency    Float    // 0-100 percentage
  period       String   // e.g. "2026-03", "2026-W12"
  jobCount     Int      @default(0)
  calculatedAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, period])
}

// ── Story Lab ────────────────────────────────────────────────────────

model StoryLabProgress {
  id          String   @id @default(cuid())
  userId      String
  moduleId    String   // A, B, C, D, E
  lessonId    String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId, lessonId])
}

model LearningPlan {
  id              String   @id @default(cuid())
  userId          String
  plan            Json     // { thirtyDay, sixtyDay, ninetyDay }
  completedActions Json?   // array of completed action keys
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SlideSubmission {
  id        String   @id @default(cuid())
  userId    String
  slides    Json     // [{ title, body, chartIntent }]
  feedback  Json?    // Claude feedback
  iteration Int      @default(1)
  scenarioId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
